# 서버에서 복사해서 .env.prod로 사용한다: cp deploy/.env.prod.example .env.prod
# .env.prod는 Git에 올리지 않는다.

# 접속 주소 (도메인이 없으면 고정 IP 3.35.10.20 → 3-35-10-20.sslip.io 형식)
SITE_ADDRESS=3-35-10-20.sslip.io

# DB 비밀번호는 긴 임의 문자열로 바꾼다
DB_NAME=supplier
DB_USER=supplier
DB_PASSWORD=change-me-long-random

# 체험 계정(admin·manager1·manager2·viewer) 공통 비밀번호. README의 demo1234!와 다르게 정한다.
# DB가 처음 만들어질 때만 적용된다.
SEED_PASSWORD=change-me-too
